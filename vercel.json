{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm --prefix frontend run build",
  "installCommand": "npm --prefix frontend install",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/e2e/:action", "destination": "/api/e2e?action=:action" },
    { "source": "/api/:path*", "destination": "https://satquery-backend-620388855751.asia-south1.run.app/api/:path*" },
    { "source": "/health", "destination": "https://satquery-backend-620388855751.asia-south1.run.app/health" },
    { "source": "/artifacts/:path*", "destination": "https://satquery-backend-620388855751.asia-south1.run.app/artifacts/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
