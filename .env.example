SATQUERY_ENV=development
SATQUERY_OFFLINE_MODE=true
# Optional: defaults to this project's models/ folder.
# SATQUERY_MODEL_DIR=D:/path/to/models
# Optional: override the integrated ten-band Sentinel-2 water bundle.
# SATQUERY_SURFACE_WATER_CHECKPOINT=D:/path/to/satquery_water_bundle
SATQUERY_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SATQUERY_ARTIFACT_DIR=artifacts
SATQUERY_MAX_UPLOAD_MB=256
SATQUERY_EARTHDIAL_ENDPOINT=
SATQUERY_CROMA_ENDPOINT=
SATQUERY_REMOTECLIP_ENDPOINT=
SATQUERY_CHANGE_ENDPOINT=
SATQUERY_VLM_ENDPOINT=
SATQUERY_VLM_API_KEY=
SATQUERY_VLM_MODEL_NAME=managed-geospatial-vlm
SATQUERY_TILE_SIZE=448
SATQUERY_TILE_OVERLAP=64
SATQUERY_MAX_MODEL_TILES=64
SATQUERY_DATABASE_PATH=artifacts/satquery.sqlite3
VITE_API_URL=http://localhost:8000
