# Environment variables
.env
*.env

# Python virtual environments & bytecode
.venv/
**/.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
**/*.egg-info/

# Pytest & test caches
.pytest_cache/
**/.pytest_cache/

# Frontend dependencies & builds
node_modules/
**/node_modules/
dist/
**/dist/
*.tsbuildinfo
**/*.tsbuildinfo

# Runtime artifacts & databases
artifacts/*
!artifacts/.gitkeep
backend/artifacts/*
!backend/artifacts/.gitkeep
*.sqlite3
*.sqlite3-journal

# OS files
.DS_Store
Thumbs.db

