{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://151.185.58.96/api/:path*" },
    { "source": "/health", "destination": "http://151.185.58.96/health" },
    { "source": "/artifacts/:path*", "destination": "http://151.185.58.96/artifacts/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
