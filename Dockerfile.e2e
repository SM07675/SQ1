FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SATQUERY_ENV=production \
    SATQUERY_OFFLINE_MODE=false \
    SATQUERY_MODEL_DIR=/app/models \
    SATQUERY_ARTIFACT_DIR=/app/artifacts \
    SATQUERY_DATABASE_PATH=/app/artifacts/satquery.sqlite3 \
    SATQUERY_DEVICE=cpu \
    HF_HOME=/app/.cache/huggingface

# Install system libraries for GDAL, OpenCV, and image processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgomp1 \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 satuser \
    && mkdir -p /app/artifacts /app/models /app/.cache \
    && chown -R satuser:satuser /app

USER satuser
WORKDIR /app
ENV PATH=/home/satuser/.local/bin:$PATH

# Install Python requirements and CPU PyTorch
COPY --chown=satuser:satuser backend/pyproject.toml ./
COPY --chown=satuser:satuser backend/app ./app
COPY --chown=satuser:satuser backend/satquery_engine ./satquery_engine

RUN pip install --no-cache-dir --user --upgrade pip setuptools wheel \
    && pip install --no-cache-dir --user torch==2.5.1+cpu torchvision==0.20.1+cpu --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir --user .

# Copy model checkpoints into image
COPY --chown=satuser:satuser models ./models

EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=10s --retries=3 --start-period=30s \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
